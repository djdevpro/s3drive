# Valeurs de développement uniquement : jamais de vraies clés ici.
NODE_ENV=development
PORT=8080
HOST=127.0.0.1
# Par défaut : <dépôt>/data et apps/web/dist
UD_DATA_DIR=
UD_WEB_DIST=
# Vide : origine déduite des en-têtes
UD_PUBLIC_URL=
# Le S3 local de dev est sur 127.0.0.1
UD_ALLOW_PRIVATE_ENDPOINTS=1

# RustFS de compose.dev.yaml (point de terminaison http://127.0.0.1:9000, console http://127.0.0.1:9001)
UD_DEV_S3_ACCESS_KEY=udadmin
UD_DEV_S3_SECRET_KEY=udadmin-dev-secret

# --- Mode instance : UD_MODE=instance ou both ---
# UD_MODE=instance
# UD_CONFIG=dev/drive.config.dev.yaml
# UD_TERMS_FILE=dev/terms.dev.md
# UD_OIDC_REFRESH_SECONDS=300
# Keycloak local de test (realm ud-dev, client confidentiel « drive ») ; valeur de dev seulement.
# UD_OIDC_ISSUER=http://localhost:8180/realms/ud-dev
# UD_OIDC_CLIENT_ID=drive
# UD_OIDC_CLIENT_SECRET=dev-client-secret
# En production : UD_PUBLIC_URL et UD_SECRET_KEY (32 octets en base64) sont obligatoires ;
# UD_S3_ACCESS_KEY_ID et UD_S3_SECRET_ACCESS_KEY sont référencés par drive.config.example.yaml.
